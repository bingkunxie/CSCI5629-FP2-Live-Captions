# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/.utmp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore Unity meta files
!/[Aa]ssets/**/*.meta

# Asset meta data for deleted assets
/[Aa]ssets/**/*.meta.orig

# IDE / solution files (regenerated by Unity)
*.csproj
*.sln
*.slnx
*.unityproj
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.apk
*.aab
*.unitypackage
*.app
.vs/
.vscode/
.idea/
.gradle/

# Build artifacts and symbols
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/
*.symbols.zip

# Crashlytics / OS files
crashlytics-build.properties
.DS_Store

# Local A3 credential (never include in submission)
.secrets/
.env
.env.*
!.env.example
umn-key.txt
gateway-url.txt
*.keystore
*.jks
*.p12
__pycache__/

# Private LAN room configuration
pair-session.json
pair-A.json
pair-B.json
room-token.txt
/.vsconfig

# Private meeting contents
meeting-agenda.json
meeting-agenda-import.json
meeting-agenda-import.json.applied
meeting-agenda.dat*
